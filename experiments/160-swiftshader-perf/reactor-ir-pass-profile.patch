+class AlCloudTimedIRCompiler : public llvm::orc::IRCompileLayer::IRCompiler
+{
+public:
+	explicit AlCloudTimedIRCompiler(llvm::orc::JITTargetMachineBuilder builder)
+	    : IRCompiler(llvm::orc::irManglingOptionsFromTargetOptions(builder.getOptions()))
+	    , compiler(std::move(builder))
+	{}
+
+	llvm::Expected<std::unique_ptr<llvm::MemoryBuffer>> operator()(llvm::Module &module) override
+	{
+		auto start = AlCloudProfileClock::now();
+		auto object = compiler(module);
+		rr::warn("ALCLOUD_JIT_BACKEND id=%s backend_ns=%lld\n",
+		         module.getModuleIdentifier().c_str(), alCloudElapsedNs(start));
+		return object;
+	}
+
+private:
+	llvm::orc::ConcurrentIRCompiler compiler;
 };
 
