 namespace {
+
+using AlCloudProfileClock = std::chrono::steady_clock;
+static std::atomic<uint64_t> alCloudProfileNextId{ 1 };
+
+static uint64_t alCloudInstructionCount(const llvm::Module &module)
+{
+	uint64_t count = 0;
+	for(const auto &function : module)
+	{
+		for(const auto &block : function)
+		{
+			count += block.size();
+		}
+	}
+	return count;
+}
+
+static long long alCloudElapsedNs(AlCloudProfileClock::time_point start)
+{
+	return std::chrono::duration_cast<std::chrono::nanoseconds>(AlCloudProfileClock::now() - start).count();
+}
 
